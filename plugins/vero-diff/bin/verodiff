#!/usr/bin/env bash
# verodiff - browse Claude Code changes turn by turn.
#
#   verodiff            browser: n/p walk steps, j/k scroll, q quits
#   verodiff --follow   same browser, but jumps to each new turn as it lands
#   verodiff -1         print the latest turn's diff and exit
#   verodiff -n 3       print the diff of step N (0 = latest)
#   verodiff -l         list steps
#   verodiff -s 3       one-line summary + --stat of step N (0 = latest)
#   verodiff --sessions list sessions that have snapshots
#   verodiff -S <id>    operate on a specific session
#   verodiff --where    show where snapshots live and how much they weigh
#   verodiff --clear    delete all snapshots for this project
#   verodiff --purge-all delete the snapshot cache for every project
set -uo pipefail

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
LIMIT=200
POLL=2

if [ "${1:-}" = "--purge-all" ]; then
  C="${VERODIFF_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/verodiff}"
  rm -rf "$C" && echo "removed every snapshot cache: $C"
  exit 0
fi

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repository - nothing to show"; exit 0; }
cd "$TOP"

CACHE="${VERODIFF_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/verodiff}"
if command -v md5sum >/dev/null 2>&1;  then key="$(printf '%s' "$TOP" | md5sum | cut -c1-12)"
elif command -v md5 >/dev/null 2>&1;   then key="$(printf '%s' "$TOP" | md5 -q | cut -c1-12)"
else key="$(printf '%s' "$TOP" | cksum | cut -d' ' -f1)"; fi
SHADOW="$CACHE/$(basename "$TOP")-$key.git"
export GIT_DIR="$SHADOW" GIT_WORK_TREE="$TOP"

[ "${1:-}" = "--where" ] && { echo "$SHADOW"; du -sh "$SHADOW" 2>/dev/null; exit 0; }
[ "${1:-}" = "--clear" ] && { rm -rf "$SHADOW" && echo "snapshots removed: $SHADOW"; exit 0; }
[ "${1:-}" = "--sessions" ] && {
  git for-each-ref --sort=-committerdate \
    --format='%(committerdate:relative)%09%(refname:strip=3)%09%(subject)' refs/verodiff/session 2>/dev/null \
    | sed 's/\[post\] /last turn: /; s/\[pre\] /no finished turn yet: /'
  exit 0; }

# --- pick a session --------------------------------------------------------
SESSION=""
if [ "${1:-}" = "-S" ]; then
  # `-S` followed by another flag means the caller's session id expanded to nothing;
  # ignore the flag rather than swallowing the next argument as a session name.
  if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then SESSION="$2"; shift 2; else shift 1; fi
fi
if [ -n "$SESSION" ] && git rev-parse -q --verify "refs/verodiff/session/$SESSION" >/dev/null 2>&1; then
  REF="refs/verodiff/session/$SESSION"
else
  REF="$(git for-each-ref --sort=-committerdate --count=1 \
         --format='%(refname)' refs/verodiff/session 2>/dev/null)"
fi
[ -n "${REF:-}" ] || REF="refs/verodiff/session/default"

base_of() { git rev-parse -q --verify "$1^" 2>/dev/null || echo "$EMPTY_TREE"; }

load_snaps() {
  mapfile -t SNAPS < <(git rev-list --max-count="$LIMIT" "$REF" 2>/dev/null)
  N=${#SNAPS[@]}
  SUBJ=(); WHEN=(); TURN=()
  local a t i p=0
  while IFS=$'\t' read -r a t; do WHEN+=("$a"); SUBJ+=("$t"); done \
    < <(git log --max-count="$LIMIT" --format='%ar%x09%s' "$REF" 2>/dev/null)
  # number the turns from the start of the session, so "turn 3" means the same
  # thing tomorrow as it does now - unlike the step index, which shifts
  for ((i=N-1;i>=0;i--)); do
    case "${SUBJ[$i]:-}" in
      "[post] "*) p=$((p+1)); TURN[$i]="$p" ;;
      *)          TURN[$i]="" ;;
    esac
  done
}

# A `post` snapshot is a turn: the diff from where the turn started to where it ended.
# A `pre` snapshot only becomes a step when the tree moved without a turn ending -
# edits you made by hand, or a turn that was interrupted before it finished. Naming it
# after the prompt that follows it would be a lie, so it does not get one.
describe() {
  local d="${SUBJ[$1]:-}"
  case "$d" in
    "[post] "*) printf 'turn %s  "%s"' "${TURN[$1]}" "${d#\[post\] }" ;;
    "[pre] "*)
        if git rev-parse -q --verify "${SNAPS[$1]}^" >/dev/null 2>&1
        then printf 'edits outside a turn'
        else printf 'session baseline'
        fi ;;
    "")         printf 'snapshot' ;;
    *)          printf '%s' "$d" ;;
  esac
}

files_of() {
  git diff --name-only "$(base_of "${SNAPS[$1]}")" "${SNAPS[$1]}" 2>/dev/null \
    | awk 'NR<=6{f=f sep $0; sep=", "} END{if(NR>6) f=f ", +" (NR-6) " more"; print f}'
}

step_arg() {                       # a step index that is always in range
  local i="${1:-0}"
  case "$i" in ''|*[!0-9]*) i=0 ;; esac
  [ "$i" -lt "$N" ] || { echo "no such step (total: $N)" >&2; return 1; }
  printf '%s' "$i"
}

plain_diff() { git diff --no-color "$@"; }
plain_stat() { git diff --no-color --stat "$@"; }
color_diff() {
  local cols="${1:-80}"; shift
  if command -v delta >/dev/null 2>&1; then
    git diff "$@" | delta --paging=never --width "$cols"
  else
    git diff --color=always "$@"
  fi
}

if ! git rev-parse -q --verify "$REF" >/dev/null 2>&1; then
  echo "No snapshots yet. Check the hooks with /hooks, then send one prompt."
  exit 0
fi
load_snaps

case "${1:-}" in
  -l|--list)
      for ((i=0;i<N;i++)); do
        printf '%3d  %-15s %s\n' "$i" "${WHEN[$i]}" "$(describe "$i")"
        f="$(files_of "$i")"; [ -n "$f" ] && printf '%21s%s\n' "" "$f"
      done; exit 0 ;;
  -s|--stat)
      i="$(step_arg "${2:-0}")" || exit 0
      printf '%s   (step %s of %s, %s)\n' "$(describe "$i")" "$i" "$N" "${WHEN[$i]}"
      plain_stat "$(base_of "${SNAPS[$i]}")" "${SNAPS[$i]}"; exit 0 ;;
  -1)        plain_diff "$(base_of "${SNAPS[0]}")" "${SNAPS[0]}"; exit 0 ;;
  -n)        i="$(step_arg "${2:-0}")" || exit 0
             plain_diff "$(base_of "${SNAPS[$i]}")" "${SNAPS[$i]}"; exit 0 ;;
  -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
esac

FOLLOW=0
[ "${1:-}" = "--follow" ] || [ "${1:-}" = "-f" ] && FOLLOW=1

# not a terminal: no browser to draw, just print the latest turn
if [ ! -t 1 ] || [ ! -t 0 ]; then
  plain_diff "$(base_of "${SNAPS[0]}")" "${SNAPS[0]}"
  exit 0
fi

# ---------------------------------------------------------------- browser --
BUF="$(mktemp -t verodiff.XXXXXX)"
# advertise that a viewer is live, so verodiff-pane reuses it instead of opening another
PIDFILE="$SHADOW/viewer-${REF##*/}.pid"
cleanup() {
  tput smam 2>/dev/null; tput cnorm 2>/dev/null; printf '\033[?1049l'
  rm -f "$BUF"
  [ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$PIDFILE"
  return 0
}
# a bare `trap cleanup INT TERM` would run cleanup and then carry on, leaving a
# signalled viewer alive with its buffer already deleted - the handler must exit.
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
printf '%s\n' "$$" > "$PIDFILE" 2>/dev/null
printf '\033[?1049h'            # alternate screen, so the shell scrollback survives
tput civis 2>/dev/null          # hide cursor
tput rmam 2>/dev/null           # no line wrap: long diff lines are truncated, not folded

idx=0; top=1; dirty=1; fresh=0
COLS=80; ROWS=24; BODY=20; TOTAL=0
trap 'dirty=1' WINCH

measure() {
  COLS="$(tput cols 2>/dev/null || echo 80)"
  ROWS="$(tput lines 2>/dev/null || echo 24)"
  BODY=$(( ROWS - 2 )); [ "$BODY" -lt 3 ] && BODY=3
}

build() {                        # render step $idx into $BUF
  measure
  local cur="${SNAPS[$idx]}" b
  b="$(base_of "$cur")"
  { git diff --color=always --stat "$b" "$cur"; echo; color_diff "$COLS" "$b" "$cur"; } > "$BUF" 2>/dev/null
  TOTAL="$(wc -l < "$BUF")"
  top=1; dirty=1
}

clamp() {
  local max=$(( TOTAL - BODY + 1 )); [ "$max" -lt 1 ] && max=1
  [ "$top" -gt "$max" ] && top=$max
  [ "$top" -lt 1 ] && top=1
}

draw() {
  measure; clamp
  local last=$(( top + BODY - 1 )); [ "$last" -gt "$TOTAL" ] && last=$TOTAL
  printf '\033[H\033[2J'
  printf '\033[1;36mstep %d/%d\033[0m  %s  \033[2m%s\033[0m\n' \
    "$((idx+1))" "$N" "$(describe "$idx")" "${WHEN[$idx]}"
  sed -n "${top},${last}p" "$BUF"
  tput cup $(( ROWS - 1 )) 0 2>/dev/null
  local nav="lines ${top}-${last}/${TOTAL}"
  [ "$fresh" = 1 ] && nav="$nav  \033[33m* new step, press r\033[0m\033[7m"
  printf '\033[7m j/k scroll  space/b page  g/G ends  n/p step  r reload  q quit   %b \033[0m' "$nav"
  dirty=0
}

poll() {                         # did a new snapshot land while we waited?
  local head; head="$(git rev-parse -q --verify "$REF" 2>/dev/null || true)"
  [ -n "$head" ] && [ "$head" != "${SNAPS[0]}" ] || return 0
  if [ "$FOLLOW" = 1 ] || { [ "$idx" = 0 ] && [ "$top" = 1 ]; }; then
    load_snaps; idx=0; fresh=0; build
  else
    fresh=1; dirty=1
  fi
}

build
while :; do
  [ "$dirty" = 1 ] && draw
  IFS= read -rsn1 -t "$POLL" k </dev/tty || { poll; continue; }
  if [ "$k" = $'\033' ]; then    # arrow keys
    IFS= read -rsn2 -t 0.01 rest </dev/tty || rest=""
    case "$rest" in "[A") k=k ;; "[B") k=j ;; "[5") k=b ;; "[6") k=" " ;; *) k="" ;; esac
  fi
  case "$k" in
    j) top=$(( top + 1 )); dirty=1 ;;
    k) top=$(( top - 1 )); dirty=1 ;;
    " "|f) top=$(( top + BODY - 2 )); dirty=1 ;;
    b) top=$(( top - BODY + 2 )); dirty=1 ;;
    g) top=1; dirty=1 ;;
    G) top=$TOTAL; dirty=1 ;;
    n) if [ $(( idx + 1 )) -lt "$N" ]; then idx=$(( idx + 1 )); build; fi ;;
    p) if [ "$idx" -gt 0 ]; then idx=$(( idx - 1 )); build; fi ;;
    r) load_snaps; idx=0; fresh=0; build ;;
    q) break ;;
  esac
done
